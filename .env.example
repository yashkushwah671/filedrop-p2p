# ===================================================================
# FileDrop Environment Configuration Template
# Copy this file to .env or configure in your cloud deployment platform
# ===================================================================

# Application Port (Automatically provided by Render/Cloud Host)
PORT=8080

# Spring Profiles (Optional: use 'prod' for production optimizations)
SPRING_PROFILES_ACTIVE=prod

# CORS Allowed Origins (Comma-separated, default is *)
# CORS_ALLOWED_ORIGINS=https://filedrop.onrender.com,http://localhost:8080

# Database Configuration (Optional - embedded H2 in-memory is default fallback)
# For MySQL / Cloud SQL / PlanetScale / Render PostgreSQL with MySQL dialect:
# DB_URL=jdbc:mysql://<host>:<port>/<database>?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_USERNAME=filedrop_user
# DB_PASSWORD=your_secure_password

# WebRTC STUN/TURN Servers (JSON formatted or comma-separated)
# FILEDROP_WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]
